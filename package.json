{
  "name": "dsh-research-workbench",
  "version": "0.1.0",
  "description": "DSH 研究工作台：普通与 Biomni 模式、代码编辑器和可追踪研究工作流",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./medical-policy": "./lib/medical-policy.js",
    "./provenance": "./lib/provenance.js",
    "./bundle": "./lib/bundle.js",
    "./execution-spec": "./lib/execution-spec.js",
    "./step-executor": "./lib/step-executor.js",
    "./workflow-engine": "./lib/workflow-engine.js",
    "./artifact-store": "./lib/artifact-store.js",
    "./run-journal": "./lib/run-journal.js",
    "./scheduler": "./lib/scheduler.js",
    "./identity": "./lib/identity.js",
    "./quota": "./lib/quota.js",
    "./rate-limit": "./lib/rate-limit.js",
    "./step-contract": "./lib/step-contract.js",
    "./host": "./lib/host.js",
    "./benchmark": "./lib/benchmark.js",
    "./signing": "./lib/signing.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./adapter": "./lib/adapter.js",
    "./fs-adapter": "./lib/fs-adapter.js",
    "./dsl": "./lib/dsl.js",
    "./executors": "./lib/executors.js",
    "./graph": "./lib/graph.js",
    "./metrics": "./lib/metrics.js",
    "./auth": "./lib/auth.js",
    "./tenancy": "./lib/tenancy.js",
    "./checkpoint": "./lib/checkpoint.js",
    "./environments": "./lib/environments.js"
  },
  "files": [
    "lib",
    "scripts",
    "docs",
    "test",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "requirements.txt",
    "docker",
    "bin"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-resources",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test --test-isolation=none lib/step-contract.test.js lib/workflow-engine.test.js lib/provenance.test.js lib/governance.test.js lib/environments.test.js lib/host.test.js lib/image-qc.test.js lib/distributed.test.js lib/index.test.js client/workflow-templates.test.js client/views.test.mjs",
    "verify": "node test/verify-goal.mjs && node test/verify-coverage.mjs && node test/verify-host-contract.mjs && node test/verify-bundle-path.mjs && node test/verify-distributed-identity.mjs && node test/verify-container-live.mjs && node test/verify-bioconductor.mjs && node test/verify-real-data.mjs && node test/verify-biomni.mjs && node test/verify-standalone.mjs && node test/verify-capabilities.mjs && node test/verify-api.mjs && node test/verify-oidc-live.mjs && node test/verify-tenancy-live.mjs && node test/verify-kubernetes-live.mjs && node test/verify-slurm-live.mjs && node test/verify-tutorial.mjs",
    "verify:container": "node test/verify-container-live.mjs",
    "build:site": "node site/build-site.mjs",
    "serve:site": "node site/serve.mjs",
    "serve:api": "node bin/dsh-research-server.mjs",
    "completion": "node bin/dsh-research-completion.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2"
  },
  "devDependencies": {
    "@codemirror/lang-javascript": "^6.2.0",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/lang-python": "^6.2.0",
    "@codemirror/lang-sql": "^6.9.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/legacy-modes": "^6.4.0",
    "@deepseek-ai/cordis": "~4.0.5",
    "codemirror": "^6.0.2",
    "esbuild": "^0.25.0",
    "playwright": "^1.56.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "bin": {
    "dsh-research": "./bin/dsh-research.mjs",
    "dsh-research-server": "./bin/dsh-research-server.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
